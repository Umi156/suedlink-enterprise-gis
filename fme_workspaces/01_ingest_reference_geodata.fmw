MACRO CsmapReprojector_2_TRANSFORMATION
# Only pass on transformation if a source coordinate system was picked
INCLUDE [    if { {} != {} } {       puts {MACRO CsmapReprojector_2_TRANSFORMATION <Unused>};    }; ]
FACTORY_DEF {*} ReprojectFactory    FACTORY_NAME { CsmapReprojector_2 }    INPUT  FEATURE_TYPE vogelschutzgebiet_OUTPUT    INPUT  FEATURE_TYPE naturschutzgebiet_OUTPUT    INPUT  FEATURE_TYPE fauna_flora_habitat_gebiet_OUTPUT    ENGINE { ENGINE_NAME FME         SOURCE ""         DESTINATION "EPSG:25832"         VERTICAL_HANDLING <Unused>         GEOID_HEIGHT_GRID "<Unused>"         TRANSFORMATION "$(CsmapReprojector_2_TRANSFORMATION)" }    INTERPOLATION_TYPE { NearestNeighbor }    RASTER_CELL_SIZE { PreserveCells }    RASTER_TOLERANCE { 0.0 }    OUTPUT { REPROJECTED FEATURE_TYPE CsmapReprojector_2_REPROJECTED          }    OUTPUT { REJECTED FEATURE_TYPE CsmapReprojector_2_<REJECTED>          }
